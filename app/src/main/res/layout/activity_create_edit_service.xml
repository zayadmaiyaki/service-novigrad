<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Dynamically added fields will go here -->

        <!-- Fields are added programmatically -->


        <!-- Dynamically added document fields will go here -->

        <!-- Fields are added programmatically -->


        <ListView
            android:id="@+id/documentsFieldsList"
            android:layout_width="227dp"
            android:layout_height="82dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/addDocumentFieldButton"
            app:layout_constraintEnd_toEndOf="@+id/textView6"
            app:layout_constraintStart_toStartOf="@+id/textView6"
            app:layout_constraintTop_toBottomOf="@+id/textView6" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Documents"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/addFormFieldButton"
            app:layout_constraintHorizontal_bias="0.529"
            app:layout_constraintStart_toStartOf="@+id/addFormFieldButton"
            app:layout_constraintTop_toBottomOf="@+id/addFormFieldButton" />

        <Button
            android:id="@+id/addFormFieldButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Field"
            app:layout_constraintEnd_toEndOf="@+id/formulaireFieldsList"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="@+id/formulaireFieldsList"
            app:layout_constraintTop_toBottomOf="@+id/formulaireFieldsList"
            android:backgroundTint="@color/blue"/>

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Formulaire"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/serviceNameEditText"
            app:layout_constraintStart_toStartOf="@+id/serviceNameEditText"
            app:layout_constraintTop_toBottomOf="@+id/serviceNameEditText"
            />

        <ListView
            android:id="@+id/formulaireFieldsList"
            android:layout_width="228dp"
            android:layout_height="87dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/addFormFieldButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView5" />

        <Button
            android:id="@+id/addDocumentFieldButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="Add Field"
            app:layout_constraintBottom_toTopOf="@+id/createButton"
            app:layout_constraintEnd_toEndOf="@+id/documentsFieldsList"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="@+id/documentsFieldsList"
            app:layout_constraintTop_toBottomOf="@+id/documentsFieldsList"
            android:backgroundTint="@color/red"/>

        <TextView
            android:id="@+id/textCreateServicePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Create/Update Service"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/serviceNameEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:height="48dp"
            android:hint="Enter Service Name"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="@+id/textCreateServicePage"
            app:layout_constraintStart_toStartOf="@+id/textCreateServicePage"
            app:layout_constraintTop_toBottomOf="@+id/textCreateServicePage" />

        <Button
            android:id="@+id/createButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="68dp"
            android:text="Create/Update"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.311"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addDocumentFieldButton"
            android:backgroundTint="@color/green"/>

        <Button
            android:id="@+id/DeleteServiceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/createButton"
            app:layout_constraintTop_toBottomOf="@+id/addDocumentFieldButton"
            app:layout_constraintVertical_bias="0.028"
            android:backgroundTint="@color/red"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>