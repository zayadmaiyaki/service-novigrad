<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".RequestForServiceActivity">

    <TextView
        android:id="@+id/docsStatus"
        android:layout_width="89dp"
        android:layout_height="23dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Incomplete"
        android:textColor="#970101"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/formFieldListViewRequest"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/textViewDocs"
        app:layout_constraintTop_toBottomOf="@+id/formFieldListViewRequest" />

    <ListView
        android:id="@+id/formFieldListViewRequest"
        android:layout_width="252dp"
        android:layout_height="217dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/textViewForm"
        app:layout_constraintHorizontal_bias="0.11"
        app:layout_constraintStart_toStartOf="@+id/textViewForm"
        app:layout_constraintTop_toBottomOf="@+id/textViewForm" />

    <TextView
        android:id="@+id/textViewForm"
        android:layout_width="125dp"
        android:layout_height="41dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:text="Formulaire"
        android:textColor="#000000"
        android:textColorHint="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/newRequestText"
        app:layout_constraintTop_toBottomOf="@+id/newRequestText" />

    <TextView
        android:id="@+id/textViewDocs"
        android:layout_width="137dp"
        android:layout_height="41dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal"
        android:text="Documents"
        android:textColor="#000000"
        android:textColorHint="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/formFieldListViewRequest"
        app:layout_constraintTop_toBottomOf="@+id/formFieldListViewRequest" />

    <Button
        android:id="@+id/buttonSubmitRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Sumbit Request"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/docsFieldListViewRequest"
        app:layout_constraintHorizontal_bias="0.451"
        app:layout_constraintStart_toStartOf="@+id/docsFieldListViewRequest"
        app:layout_constraintTop_toBottomOf="@+id/docsFieldListViewRequest"
        app:layout_constraintVertical_bias="0.051" />

    <ListView
        android:id="@+id/docsFieldListViewRequest"
        android:layout_width="253dp"
        android:layout_height="171dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/textViewDocs"
        app:layout_constraintHorizontal_bias="0.163"
        app:layout_constraintStart_toStartOf="@+id/textViewDocs"
        app:layout_constraintTop_toBottomOf="@+id/textViewDocs" />

    <TextView
        android:id="@+id/newRequestText"
        android:layout_width="346dp"
        android:layout_height="75dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="New Request"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/formStatus"
        android:layout_width="87dp"
        android:layout_height="23dp"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Incomplete"
        android:textColor="#970101"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/newRequestText"
        app:layout_constraintHorizontal_bias="0.174"
        app:layout_constraintStart_toEndOf="@+id/textViewForm"
        app:layout_constraintTop_toBottomOf="@+id/newRequestText" />

</androidx.constraintlayout.widget.ConstraintLayout>