<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RedirectRequestsActivity">

    <TextView
        android:id="@+id/textRedirectRequest"
        android:layout_width="322dp"
        android:layout_height="41dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="Redirect Request"
        android:textColor="#000000"
        android:textColorHint="#000000"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.076" />

    <Button
        android:id="@+id/buttonAccept"
        android:layout_width="134dp"
        android:layout_height="61dp"
        android:layout_marginTop="489dp"
        android:layout_marginEnd="44dp"
        android:text="Accept"
        app:layout_constraintEnd_toStartOf="@+id/buttonDecline"
        app:layout_constraintTop_toBottomOf="@+id/textRedirectRequest" />

    <Button
        android:id="@+id/buttonDecline"
        android:layout_width="134dp"
        android:layout_height="61dp"
        android:layout_marginTop="488dp"
        android:layout_marginEnd="44dp"
        android:text="Decline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textRedirectRequest" />

</androidx.constraintlayout.widget.ConstraintLayout>