<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Dynamically added fields will go here -->

        <!-- Fields are added programmatically -->


        <!-- Dynamically added document fields will go here -->

        <!-- Fields are added programmatically -->


        <ListView
            android:id="@+id/documentsFieldsListCreate"
            android:layout_width="227dp"
            android:layout_height="82dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/addDocumentFieldButtonCreatePage"
            app:layout_constraintEnd_toEndOf="@+id/textView6"
            app:layout_constraintStart_toStartOf="@+id/textView6"
            app:layout_constraintTop_toBottomOf="@+id/textView6" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Documents"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/addFormFieldButtonCreatePage"
            app:layout_constraintHorizontal_bias="0.529"
            app:layout_constraintStart_toStartOf="@+id/addFormFieldButtonCreatePage"
            app:layout_constraintTop_toBottomOf="@+id/addFormFieldButtonCreatePage" />

        <Button
            android:id="@+id/addFormFieldButtonCreatePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Field"
            app:layout_constraintEnd_toEndOf="@+id/formulaireFieldsListCreate"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="@+id/formulaireFieldsListCreate"
            app:layout_constraintTop_toBottomOf="@+id/formulaireFieldsListCreate"
            android:backgroundTint="@color/blue"/>

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Formulaire"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/createServiceNameEditText"
            app:layout_constraintStart_toStartOf="@+id/createServiceNameEditText"
            app:layout_constraintTop_toBottomOf="@+id/createServiceNameEditText"
            />

        <ListView
            android:id="@+id/formulaireFieldsListCreate"
            android:layout_width="228dp"
            android:layout_height="87dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/addFormFieldButtonCreatePage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView5" />

        <Button
            android:id="@+id/addDocumentFieldButtonCreatePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/blue"
            android:text="Add Field"
            app:layout_constraintBottom_toTopOf="@+id/createServiceButtonCreatePage"
            app:layout_constraintEnd_toEndOf="@+id/documentsFieldsListCreate"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="@+id/documentsFieldsListCreate"
            app:layout_constraintTop_toBottomOf="@+id/documentsFieldsListCreate" />

        <TextView
            android:id="@+id/textCreateServicePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="CreateService"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/createServiceNameEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:height="48dp"
            android:hint="Enter Service Name"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="@+id/textCreateServicePage"
            app:layout_constraintStart_toStartOf="@+id/textCreateServicePage"
            app:layout_constraintTop_toBottomOf="@+id/textCreateServicePage" />

        <Button
            android:id="@+id/createServiceButtonCreatePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="68dp"
            android:backgroundTint="@color/green"
            android:text="Create"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.348"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addDocumentFieldButtonCreatePage" />

        <Button
            android:id="@+id/DeleteServiceButtonCreatePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:backgroundTint="@color/red"
            android:text="Delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.133"
            app:layout_constraintStart_toEndOf="@+id/createServiceButtonCreatePage"
            app:layout_constraintTop_toBottomOf="@+id/addDocumentFieldButtonCreatePage"
            app:layout_constraintVertical_bias="0.028" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>